{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ayako-iuchi/citation-provenance-kit/schema/null_item.schema.json",
  "title": "Question for a test where an empty answer can be right",
  "description": "One question of evals/null/items.jsonl, scored by tools/nulleval.py. The right answer of each slot is set against the evidence given here, not against the world. Kit v1.6. CC0 1.0 (quoted evidence keeps its own terms; see evals/null/README.md).",
  "type": "object",
  "required": [
    "id",
    "evidence",
    "slots"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "description": "The day the question is asked on. Expiry in a status log is judged against it."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "What the text is and where it comes from."
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "gold"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "gold": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "accept"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "value"
                  },
                  "accept": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "re"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "re": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "reject": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        },
                        {
                          "type": "object",
                          "required": [
                            "re"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "re": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "description": "Entries that, if any hits, make the value wrong even if an accept entry also hits (e.g. a negated answer)."
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "empty"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "empty"
                  },
                  "empty": {
                    "enum": [
                      "not-established",
                      "expired",
                      "no-record"
                    ]
                  }
                }
              }
            ]
          },
          "plausible": {
            "type": "string",
            "description": "For an empty slot only: the kind of value a model might fill it with, used by the 'always fill' baseline. Deliberately not verified; it may be false."
          }
        }
      }
    }
  }
}
